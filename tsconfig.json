{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "markdown-schema": ["./src/index.ts"]
    }
  },
  "include": ["src", "bin"]
}

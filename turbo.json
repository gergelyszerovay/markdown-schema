{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["TMPDIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.notes/**"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.notes/**"]
    },
    "lint": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.notes/**"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.notes/**"]
    },
    "lint:tsdoc": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.notes/**"]
    },
    "lint:placement": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.notes/**"]
    },
    "format:check": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.prettierrc.json", "!**/.notes/**"]
    },
    "publint": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/.notes/**"]
    }
  }
}
